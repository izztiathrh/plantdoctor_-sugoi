{
  "expo": {
    "name": "PlantDoctor",
    "slug": "PlantDoctor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/plantdoctor-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/plantdoctor-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#edf2ec"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/plantdoctor-adaptive-icon.png",
        "backgroundColor": "#edf2ec"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/plantdoctor-favicon.png"
    }
  }
}
